# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-only Supabase configuration. Never expose service role keys in VITE_* variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Canonical public app origin used for QR/receipt links in production
VITE_PUBLIC_SITE_URL=https://your-domain.example
